{
    "name": "w4msolutions/w4m-email-gateway",
    "description": "Yii2 mailer adapter that sends emails through the W4M Email Gateway service.",
    "type": "yii2-extension",
    "license": "proprietary",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1.0",
        "yiisoft/yii2": ">=2.0.45",
        "yiisoft/yii2-symfonymailer": ">=2.0.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "W4MSolutions\\W4mEmailGateway\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "W4MSolutions\\W4mEmailGateway\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "scripts": {
        "test": "vendor/bin/phpunit -c phpunit.xml.dist"
    }
}
